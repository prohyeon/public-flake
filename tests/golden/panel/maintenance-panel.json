    "            .stove-status-item.stove-total { border-top: 1px solid var(--border); margin-top: 8px; padding-top: 12px; }",
    "            .stove-mission-item { position: relative; cursor: help; }",
    "            .stove-mission-tooltip {",
    "                position: absolute;",
