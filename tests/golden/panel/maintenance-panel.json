    "                --muted: #8a8a8a;",
    "                --accent: #3b82f6;",
    "                --ok: #34d399;",
    "                --warn: #fbbf24;",
    "                --error: #f87171;",
    "                background: var(--bg);",
    "                border: 1px solid var(--border);",
    "                border-radius: 12px;",
    "                padding: 20px;",
    "                margin: 24px 0;",
