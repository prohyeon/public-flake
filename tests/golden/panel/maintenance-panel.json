    "                max-height: 420px;",
    "                overflow-y: auto;",
    "                scroll-behavior: smooth;",
    "            }",
    "            .stove-log-section::-webkit-scrollbar { width: 8px; }",
    "            .stove-log-section::-webkit-scrollbar-track { background: transparent; }",
