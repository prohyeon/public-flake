    "                margin-bottom: 12px;",
    "                min-height: 28px;",
    "            }",
    "            .stove-card-title { font-size: 14px; font-weight: 700; color: #ffffff; letter-spacing: 0.02em; }",
    "            .stove-ghost-btn {",
    "                background: transparent;",
