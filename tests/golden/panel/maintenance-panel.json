    "                margin-bottom: 16px;",
    "                align-items: stretch;",
    "            }",
    "            .stove-actions-secondary {",
    "                display: grid;",
    "                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);",
    "                gap: 10px;",
    "                min-width: 0;",
    "            }",
    "            .stove-btn {",
    "                background: var(--surface-2);",
    "                border: 1px solid var(--border);",
    "                color: var(--text);",
    "                padding: 10px 14px;",
